// 应用图标：IDI_ICON1（最低 ID）会被 Windows 用作 exe 文件图标、任务栏图标与快捷方式默认图标
IDI_ICON1 ICON "resources/icon/logo.ico"

// 版本资源：exe 属性页 / 任务管理器里显示的版本与作者（与安装器版本保持一致）
1 VERSIONINFO
FILEVERSION 4,0,0,0
PRODUCTVERSION 4,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "moshuai"
      VALUE "FileDescription", "GitFlow Pro - Desktop Git client for GitHub/Gitee"
      VALUE "FileVersion", "4.0.0"
      VALUE "InternalName", "GitFlowPro"
      VALUE "LegalCopyright", "Copyright (C) moshuai"
      VALUE "OriginalFilename", "GitFlowPro.exe"
      VALUE "ProductName", "GitFlow Pro"
      VALUE "ProductVersion", "4.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
